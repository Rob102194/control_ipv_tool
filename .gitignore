# Ignorar archivos de compilación y distribución (PyInstaller, en la raíz)
/dist
/build

# Ignorar archivos de configuración de Visual Studio Code
.vscode

# --- Go ---
/bin/
*.test
*.out
coverage.txt

# --- Bases de datos locales ---
*.db
*.db-shm
*.db-wal

# --- Python (Fase 0) ---
backend/.venv/
backend/**/__pycache__/
.pytest_cache/

# --- Frontend build ---
frontend/dist/
frontend/node_modules/
# El SPA compilado va a web/dist/ y lo embebe Go. No se versiona (lo genera
# `make frontend` / CI); se conserva .gitkeep para que `//go:embed` compile.
web/dist/*
!web/dist/.gitkeep

# macOS
.DS_Store
